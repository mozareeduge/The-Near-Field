# Optional production geocoder. Without it, Round 1 retains the bounded coordinate-bearing Wikipedia fallback.
MAPTILER_API_KEY=

# Optional pedestrian route verification. Without this, multi-place movement MUST remain RELATIONAL_UNVERIFIED.
ORS_API_KEY=

# Provisional Round-2 model adapters. Final model pair is a Round-3 decision after comparative literary/runtime evaluation.
GATHERER_MODEL=@cf/zai-org/glm-4.7-flash
SYNTHESIZER_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Required in production. Comma-separated exact origins allowed to call the
# Worker's API (e.g. https://nearbyfield.example,https://staging.nearbyfield.example).
# Unset only in local development -- the Worker then reflects any Origin,
# which must never be the deployed default.
ALLOWED_ORIGINS=
