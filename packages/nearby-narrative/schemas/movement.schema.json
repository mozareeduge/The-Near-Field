{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "route_verified",
    "order",
    "total_distance_m",
    "legs"
  ],
  "properties": {
    "state": {
      "enum": [
        "NONE",
        "VERIFIED",
        "RELATIONAL_UNVERIFIED"
      ]
    },
    "route_verified": {
      "type": "boolean"
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "total_distance_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "distance_m"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "distance_m": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
